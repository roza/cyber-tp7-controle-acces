{
    "name": "kineo/tp7-controle-acces",
    "description": "TP7 cybersécurité — contrôle d'accès et IDOR",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Kineo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kineo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "init-db": "php bin/init-db.php",
        "test": "phpunit"
    }
}
